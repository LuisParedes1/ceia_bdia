FROM duckdb/duckdb:1.4.3 AS duckdb

FROM debian:12.10-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl socat \
    && rm -rf /var/lib/apt/lists/*
COPY --from=duckdb /duckdb /usr/local/bin/duckdb
RUN duckdb :memory: -c "INSTALL ui;"
ENTRYPOINT ["/usr/local/bin/duckdb"]
