# Copy to .env for local development. Do not commit .env.
APP_ENV=development
POSTGRES_PASSWORD=<set-a-local-password>
MINIO_ROOT_USER=<set-a-local-user>
MINIO_ROOT_PASSWORD=<set-a-local-password>

# Host port mappings (standard defaults)
LANDING_PORT=4321
WEB_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
